# ── TikTok app credentials ────────────────────────────────────────────────
# Create an app at https://developers.tiktok.com/ , add the "Content Posting API"
# product, and copy the client key/secret here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must match a Redirect URI registered on the TikTok app, character for character.
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/auth/callback

# ── Where the dashboard listens ───────────────────────────────────────────
HOST=127.0.0.1
PORT=8765

# ── Folders ───────────────────────────────────────────────────────────────
# Defaults sit inside this project; absolute paths work too.
# VIDEOS_DIR=/home/you/tiktok-videos
# STATE_DIR=/home/you/.tiktok-uploader

# ── Posting defaults (a per-video .json sidecar overrides these) ───────────
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# Unaudited apps only get SELF_ONLY; the tool falls back automatically.
PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
DISABLE_COMMENT=false
DISABLE_DUET=false
DISABLE_STITCH=false
COVER_TIMESTAMP_MS=1000

# ── Scheduling ────────────────────────────────────────────────────────────
# Local times. One video goes out per slot.
SCHEDULE_TIMES=10:00,18:00
MIN_GAP_MINUTES=30
MAX_ATTEMPTS=3
AUTOPOST=true
